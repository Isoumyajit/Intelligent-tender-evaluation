# Database connection (use port 5433 if using setup-db.sh)
DATABASE_URL=postgresql+asyncpg://ite_user:ite_password@localhost:5433/ite_db

# Sarvam AI API key (required for LLM-based evaluation)
SARVAM_API_KEY=your_sarvam_api_key_here

# Mock data flags (set to false to use real document processing)
MOCK_BIDDER_DOCS=true
MOCK_TENDER_DOCS=true
